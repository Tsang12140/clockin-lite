# Data mode. `virtual` runs without an external database; use `postgres` for persistent storage.
CLOCKIN_DATA_MODE=virtual

# Local development database, only required when CLOCKIN_DATA_MODE=postgres.
DATABASE_URL=postgresql://clockin:clockin@localhost:5432/clockin

# Full Docker app database URL, only required when CLOCKIN_DATA_MODE=postgres.
APP_DATABASE_URL=postgresql://clockin:clockin@db:5432/clockin
POSTGRES_USER=clockin
POSTGRES_PASSWORD=clockin
POSTGRES_DB=clockin
POSTGRES_PORT=5432
APP_PORT=3000

# Required in production. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: separate key for encrypting AI settings. Defaults to SESSION_SECRET if empty.
AI_CONFIG_SECRET=

# Developer panel unlock code, 4 digits.
DEV_PASSWORD=2468

# Optional invite-only demo login. When enabled, /login only asks for the invite code.
INVITE_LOGIN_ENABLED=false
INVITE_CODE=merging
# Optional. If empty, the first admin account is used.
INVITE_LOGIN_PHONE=

# Optional AI assistant. If AI_API_KEY is empty, the AI module stays hidden/disabled.
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional QWeather. If empty, configure it later in Settings -> Weather.
QWEATHER_KEY=
QWEATHER_LOCATION=
QWEATHER_CITY=

# Local SQL backups.
BACKUP_DIR=./backups
PG_DUMP_PATH=pg_dump

# Optional S3-compatible backup. If empty, configure it later in Settings -> Backup.
BACKUP_S3_ENABLED=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups/db
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
